# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── BACKEND (Express scraper) ─────────────────────────────────────────────────
# Both vars point to the same backend — NEXT_PUBLIC_ is used client-side
NEXT_PUBLIC_API_URL="https://api.mangaread.pro"
NEXT_PUBLIC_SCRAPER_URL="https://api.mangaread.pro"
API_URL="https://api.mangaread.pro"

# ── AUTH ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET="your-64-byte-hex-secret-here-minimum-32-chars-required-in-production"

# ── SITE ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="MangaReader"

# ── SEO / INDEXNOW ─────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(16))"
# Then create public/<key>.txt containing just the key (see src/lib/indexnow.ts).
INDEXNOW_KEY="generate-a-random-hex-key-and-set-it-here"
